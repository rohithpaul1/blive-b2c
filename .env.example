# ---------------------------------------------------------------------------
# BLive B2C frontend — environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. For production, set these in your
# hosting provider's dashboard (Vercel / Netlify / Amplify) — NOT in a
# committed file.
#
# WARNING: Vite inlines every VITE_* variable into the public JavaScript
# bundle at build time. Anyone can read them via devtools. Only publishable
# values belong here. Never add a Razorpay key_secret, a database URL, or a
# private API token.
#
# These are read at BUILD time, not run time. Changing a value in the hosting
# dashboard requires a redeploy to take effect.
# ---------------------------------------------------------------------------

# Base URL of the backend API, INCLUDING the /b2c/api prefix and no trailing slash.
# Dev:  https://devevolve-api.blive.co.in/b2c/api
# Prod: https://<your-production-api-host>/b2c/api
VITE_BACKEND_URL=https://devevolve-api.blive.co.in/b2c/api

# Shared Convex deployment used by the admin platform. Catalog, hubs,
# authentication, availability, pricing, and bookings are migrated here one
# domain at a time. This URL is public and safe to include in the Vite bundle.
# Dev:  https://clever-wildcat-573.convex.cloud
# Prod: https://helpful-hummingbird-285.convex.cloud
VITE_CONVEX_URL=https://clever-wildcat-573.convex.cloud

# Razorpay publishable key id (key_id — the one that starts rzp_test_ or rzp_live_).
# The backend also returns this on the handle-payment response and that value
# wins; this is the fallback. Use rzp_test_* for any non-production deploy.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me

# Keep checkout simulated until the real Razorpay gateway is enabled. When this
# is true, VITE_RAZORPAY_KEY_ID is optional and no real charge is attempted.
VITE_SIMULATE_PAYMENT=true

# /auth/send-otp on the B2C backend sends a real SMS now — leave this false
# so the login screen doesn't show a fake "Test environment code: 123456"
# banner over a real one that was just texted to the user. Only set true
# against a backend/environment that's still faking OTP delivery.
VITE_SIMULATE_OTP=false

# Base origin of the master/tenant-resolution service (no path, no trailing
# slash). Used once per tab to resolve the tenant id + logo/name for the
# current hostname via:
#   GET {VITE_MASTER_SERVICE_URL}/masterService/api/tenant/resolve/by-website-domain?domain=<hostname>
# Real response shape (flat, no wrapper) — any field this omits falls back
# to BLive's own default. Note there is no video field: homeScreenUrl is an
# IMAGE, not wired into the <video> hero — see TenantConfigContext.jsx.
#   { "tenantId": "...", "tenantName": "...", "tenantCode": "...",
#     "websiteDomain": "...", "logoUrl": "...", "homeScreenUrl": "..." }
# Leave unset to skip resolution entirely (logged as a warning, not fatal) —
# the app then renders with BLive's default branding, same as before this existed.
# Dev: https://evolve-api.dev.blive.co.in
VITE_MASTER_SERVICE_URL=https://evolve-api.dev.blive.co.in
